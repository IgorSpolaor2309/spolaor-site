# ─── Contatos e domínio (ainda NÃO definidos) ───────────────────────────────
# Deixe vazio até haver valores definitivos. Vazio = o contato não aparece no site
# e, sem URL, o site fica com noindex (não é indexado por buscadores).
NEXT_PUBLIC_SITE_URL=
# Liberar indexação por buscadores (true). Deixe vazio enquanto o domínio for provisório: o site fica com
# noindex e o robots.txt bloqueia tudo, mas o canonical já usa NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_ALLOW_INDEXING=
NEXT_PUBLIC_CONTACT_EMAIL=
# Só dígitos, com DDI e DDD (ex.: 55 + DDD + número)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Destino dos leads (ainda NÃO definido) ─────────────────────────────────
# Nenhum conector está ativo. Veja src/lib/leads/connectors/README.md para ligar
# Supabase, CRM, n8n, Make ou e-mail quando a decisão for tomada.
# Em desenvolvimento, sem conector, os leads aparecem só no terminal.

# ─── Envio dos leads por e-mail (servidor; configure na Vercel, nunca no navegador) ──
# Os três precisam existir para o formulário ficar ativo. Depois de definir, faça Redeploy.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ─── Medição de campanhas (tudo desligado enquanto vazio) ───────────────────
# Meta Pixel (só dígitos): PageView em toda página (o primeiro já no <head>), ViewContent nas páginas de oferta,
# FormStart no primeiro toque num formulário de lead e Lead só depois do envio aceito (200 com id do lead).
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 (opcional) e Google Ads (opcional; a conversão exige também o rótulo).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# ─── Atendimento com IA no WhatsApp (/atendimento-ia) ── somente servidor ─────
# Separe por ambiente na Vercel: Preview = credenciais de TESTE; Production = produção.
# A contratação só abre com TODOS definidos e IA_CONTRATACAO_ATIVA=true (veja docs/ATENDIMENTO-IA.md).
IA_CONTRATACAO_ATIVA=
IA_PRECO_MENSAL=
IA_LIMITE_RESPOSTAS=
IA_ZM_PLAN_ID=
IA_ZM_PLAYBOOK_IDS=
IA_ZM_PLAYBOOK_VARIAVEIS=
IA_PAINEL_URL=
IA_MP_FREQUENCIA=
IA_CARENCIA_DIAS=10
IA_MEIOS_PAGAMENTO=
IA_OPERACAO_EMAIL=
IA_ADMIN_TOKEN=
CRON_SECRET=
ZM_API_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
DATABASE_URL=
IA_TOKEN_VALIDACAO=
# true = estorno do arrependimento executado no pedido. Vazio = só pela ação reembolsar do admin (padrão).
IA_REEMBOLSO_AUTOMATICO=
IA_MP_NOTIFICATION_URL=
IA_URL_PUBLICA=
# Só para testes locais: IA_DB_POOL_MAX (tamanho do pool) e IA_TESTE_RELOGIO=1 (relógio simulado no cron, nunca na Vercel)
