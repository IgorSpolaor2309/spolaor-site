# ─── Contatos e domínio (ainda NÃO definidos) ───────────────────────────────
# Deixe vazio até haver valores definitivos. Vazio = o contato não aparece no site
# e, sem URL, o site fica com noindex (não é indexado por buscadores).
NEXT_PUBLIC_SITE_URL=
# Liberar indexação por buscadores (true). Deixe vazio enquanto o domínio for provisório: o site fica com
# noindex e o robots.txt bloqueia tudo, mas o canonical já usa NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_ALLOW_INDEXING=
NEXT_PUBLIC_CONTACT_EMAIL=
# Só dígitos, com DDI e DDD (ex.: 55 + DDD + número)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Destino dos leads (ainda NÃO definido) ─────────────────────────────────
# Nenhum conector está ativo. Veja src/lib/leads/connectors/README.md para ligar
# Supabase, CRM, n8n, Make ou e-mail quando a decisão for tomada.
# Em desenvolvimento, sem conector, os leads aparecem só no terminal.

# ─── Envio dos leads por e-mail (servidor; configure na Vercel, nunca no navegador) ──
# Os três precisam existir para o formulário ficar ativo. Depois de definir, faça Redeploy.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ─── Medição de campanhas (tudo desligado enquanto vazio) ───────────────────
# Meta Pixel: PageView em toda página, ViewContent nas páginas de oferta e Lead só depois do envio aceito.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 (opcional) e Google Ads (opcional; a conversão exige também o rótulo).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
